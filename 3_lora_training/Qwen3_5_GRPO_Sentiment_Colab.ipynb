   "source": [
    "#@title 8. 保存模型\n",
    "output_dir = \"sentiment_grpo_lora\"\n",
    "\n",
    "model.save_lora(output_dir)\n",
    "print(f\"\\nLoRA 保存到: {output_dir}\")\n",
    "\n",
    "# 配置记录\n",
    "import json\n",
    "config = {\n",
    "    \"model\": \"unsloth/Qwen3.5-4B\",\n",
    "    \"method\": \"GRPO\",\n",
    "    \"data\": \"train_answer_first.json\",\n",
    "    \"max_steps\": MAX_STEPS,\n",
    "    \"lora_rank\": LORA_RANK,\n",
    "    \"temperature\": TEMPERATURE,\n",
    "    \"train_time_seconds\": trainer_stats.metrics['train_runtime'],\n",
    "}\n",
    "with open(f\"{output_dir}/train_config.json\", \"w\") as f:\n",
    "    json.dump(config, f, indent=2)\n",
    "\n",
    "print(\"\\n✓ 模型保存完成\")"
   ]
